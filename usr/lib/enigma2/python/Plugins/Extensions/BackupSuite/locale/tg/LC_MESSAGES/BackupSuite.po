msgid " BLUE: Show this help screen\n"
msgstr "КАБУД: Ин экрани ёриро нишон диҳед\n"

msgid " Barry Allen: Multiboot backup (if installed)\n"
msgstr "Барри Аллен: Нусхаи эҳтиётии бисёрҷанба (агар насб карда шуда бошад)\n"

msgid " GREEN: Start backup for selected device\n"
msgstr "САБЗ: Нусхабардории дастгоҳи интихобшударо оғоз кунед\n"

msgid " HDD Backup: Full system backup to internal hard drive\n"
msgstr "Нусхаи эҳтиётии HDD: Нусхаи пурраи система ба диски сахти дохилӣ\n"

msgid " MMC Backup: Backup to external storage (eMMC)\n"
msgstr "Нусхаи MMC: Нусхабардорӣ ба нигаҳдории беруна (eMMC)\n"

msgid " NET Backup: Backup to network storage (NAS/SMB)\n"
msgstr "NET нусхабардорӣ: Нусхабардорӣ ба нигаҳдории шабака (NAS/SMB)\n"

msgid " USB Backup: Create a bootable USB recovery stick\n"
msgstr "Нусхаи USB: Стики барқароршавандаи USB эҷод кунед\n"

msgid " Use UP/DOWN buttons to navigate through backup options\n"
msgstr "Барои гузаштан аз имконоти нусхабардорӣ тугмаҳои БОЛО/ПОЁН-ро истифода баред\n"

msgid " YELLOW: Start restore process\n"
msgstr "ЗАРД: Оғози раванди барқарорсозӣ\n"
