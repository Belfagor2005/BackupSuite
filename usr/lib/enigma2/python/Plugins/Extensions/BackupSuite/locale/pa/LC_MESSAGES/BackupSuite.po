msgid "- Check share permissions (read/write)\n"
msgstr "- ਸ਼ੇਅਰ ਅਨੁਮਤੀਆਂ ਦੀ ਜਾਂਚ ਕਰੋ (ਪੜ੍ਹਨ/ਲਿਖਣ)\n"

msgid "- Ensure NAS is powered on and accessible\n"
msgstr "- ਯਕੀਨੀ ਬਣਾਓ ਕਿ NAS ਚਾਲੂ ਹੈ ਅਤੇ ਪਹੁੰਚਯੋਗ ਹੈ\n"

msgid "- Enter server IP, share name, username and password\n"
msgstr "- ਸਰਵਰ IP, ਸ਼ੇਅਰ ਨਾਮ, ਉਪਭੋਗਤਾ ਨਾਮ ਅਤੇ ਪਾਸਵਰਡ ਦਰਜ ਕਰੋ\n"

msgid "- Go to Main Menu > Setup > System > Storage Manager\n"
msgstr "- ਮੇਨ ਮੀਨੂ > ਸੈੱਟਅੱਪ > ਸਿਸਟਮ > ਸਟੋਰੇਜ਼ ਮੈਨੇਜਰ \n 'ਤੇ ਜਾਓ"

msgid "- HDD backups: Stored in /media/hdd/backup\n"
msgstr "- HDD ਬੈਕਅੱਪ: /media/hdd/backup\n ਵਿੱਚ ਸਟੋਰ ਕੀਤਾ ਗਿਆ"

msgid "- Keep regular backups of your system\n"
msgstr "- ਆਪਣੇ ਸਿਸਟਮ ਦਾ ਨਿਯਮਤ ਬੈਕਅੱਪ ਰੱਖੋ\n"

msgid "- NET backups: Require mounted CIFS/NFS share with write permissions\n"
msgstr "- NET ਬੈਕਅੱਪ: ਲਿਖਣ ਦੀ ਇਜਾਜ਼ਤ ਦੇ ਨਾਲ ਮਾਊਂਟ ਕੀਤੇ CIFS/NFS ਸ਼ੇਅਰ ਦੀ ਲੋੜ ਹੈ\n"

msgid "- Never interrupt backup/restore processes\n"
msgstr "- ਬੈਕਅੱਪ/ਰੀਸਟੋਰ ਪ੍ਰਕਿਰਿਆਵਾਂ ਵਿੱਚ ਕਦੇ ਵੀ ਵਿਘਨ ਨਾ ਪਾਓ\n"

msgid "- Restore: Works from HDD, USB, NET or MMC storage\n"
msgstr "- ਰੀਸਟੋਰ ਕਰੋ: HDD, USB, NET ਜਾਂ MMC ਸਟੋਰੇਜ ਤੋਂ ਕੰਮ ਕਰਦਾ ਹੈ\n"

msgid "- Select 'Network Storage' and add your NAS/SMB share\n"
msgstr "- 'ਨੈੱਟਵਰਕ ਸਟੋਰੇਜ' ਚੁਣੋ ਅਤੇ ਆਪਣਾ NAS/SMB ਸ਼ੇਅਰ ਸ਼ਾਮਲ ਕਰੋ\n"

msgid "- Test connection with ping command\n"
msgstr "- ਪਿੰਗ ਕਮਾਂਡ ਨਾਲ ਕਨੈਕਸ਼ਨ ਦੀ ਜਾਂਚ ਕਰੋ\n"

msgid "- USB backups: Require FAT32-formatted drive with 'backupstick' file\n"
msgstr "- USB ਬੈਕਅੱਪ: 'ਬੈਕਅੱਪਸਟਿਕ' ਫਾਈਲ ਨਾਲ FAT32-ਫਾਰਮੈਟਡ ਡਰਾਈਵ ਦੀ ਲੋੜ ਹੈ\n"

msgid "- Use quality USB drives for recovery sticks\n"
msgstr "- ਰਿਕਵਰੀ ਸਟਿਕਸ ਲਈ ਗੁਣਵੱਤਾ ਵਾਲੀਆਂ USB ਡਰਾਈਵਾਂ ਦੀ ਵਰਤੋਂ ਕਰੋ\n"

msgid "- Verify username/password are correct\n"
msgstr "- ਪੁਸ਼ਟੀ ਕਰੋ ਕਿ ਯੂਜ਼ਰਨਾਮ/ਪਾਸਵਰਡ ਸਹੀ ਹਨ\n"

msgid "- Verify you have enough free storage space\n"
msgstr "- ਪੁਸ਼ਟੀ ਕਰੋ ਕਿ ਤੁਹਾਡੇ ਕੋਲ ਕਾਫ਼ੀ ਖਾਲੀ ਸਟੋਰੇਜ ਸਪੇਸ ਹੈ\n"

msgid "1. Mount your network share first:\n"
msgstr "1. ਪਹਿਲਾਂ ਆਪਣਾ ਨੈੱਟਵਰਕ ਸ਼ੇਅਰ ਮਾਊਂਟ ਕਰੋ:\n"

msgid "2. Select 'NET Backup' from the device list\n"
msgstr "2. ਡਿਵਾਈਸ ਸੂਚੀ ਤੋਂ 'NET ਬੈਕਅੱਪ' ਚੁਣੋ\n"

msgid "3. Choose your mounted network share\n"
msgstr "3. ਆਪਣਾ ਮਾਊਂਟ ਕੀਤਾ ਨੈੱਟਵਰਕ ਸਾਂਝਾਕਰਨ ਚੁਣੋ\n"

msgid "A recording is currently running. Please stop the recording before trying to start a flashing."
msgstr "ਇਸ ਸਮੇਂ ਰਿਕਾਰਡਿੰਗ ਚੱਲ ਰਹੀ ਹੈ। ਫਲੈਸ਼ਿੰਗ ਸ਼ੁਰੂ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਕਿਰਪਾ ਕਰਕੇ ਰਿਕਾਰਡਿੰਗ ਬੰਦ ਕਰੋ।"

