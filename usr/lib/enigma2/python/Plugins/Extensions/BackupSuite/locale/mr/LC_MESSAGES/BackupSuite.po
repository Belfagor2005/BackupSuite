msgstr "ofgwrite फ्लॅश चालवण्यासाठी आता enigma2 थांबवेल.\n"

msgid "{0} (maybe error)"
msgstr "{0} (कदाचित त्रुटी)"

msgid "{0} (maybe ok)"
msgstr "{0} (कदाचित ठीक आहे)"

msgid "{0} Backup"
msgstr "{0} बॅकअप"

msgid " BLUE: Show this help screen\n"
msgstr "निळा: ही मदत स्क्रीन दाखवा\n"

msgid " Barry Allen: Multiboot backup (if installed)\n"
msgstr "बॅरी ऍलन: मल्टीबूट बॅकअप (इंस्टॉल केल्यास)\n"

msgid " GREEN: Start backup for selected device\n"
msgstr "हिरवा: निवडलेल्या डिव्हाइससाठी बॅकअप सुरू करा\n"

msgid " HDD Backup: Full system backup to internal hard drive\n"
msgstr "HDD बॅकअप: अंतर्गत हार्ड ड्राइव्हवर संपूर्ण सिस्टम बॅकअप\n"

msgid " MMC Backup: Backup to external storage (eMMC)\n"
msgstr "MMC बॅकअप: बाह्य संचयनावर बॅकअप (eMMC)\n"

msgid " NET Backup: Backup to network storage (NAS/SMB)\n"
msgstr "NET बॅकअप: नेटवर्क स्टोरेजवर बॅकअप (NAS/SMB)\n"

msgid " USB Backup: Create a bootable USB recovery stick\n"
msgstr "USB बॅकअप: बूट करण्यायोग्य USB पुनर्प्राप्ती स्टिक तयार करा\n"

msgid " Use UP/DOWN buttons to navigate through backup options\n"
msgstr "बॅकअप पर्यायांमधून नेव्हिगेट करण्यासाठी वर/खाली बटणे वापरा\n"

msgid " YELLOW: Start restore process\n"
msgstr "पिवळा: पुनर्संचयित प्रक्रिया सुरू करा\n"
