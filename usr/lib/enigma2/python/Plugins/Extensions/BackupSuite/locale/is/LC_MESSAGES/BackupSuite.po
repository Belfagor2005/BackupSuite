msgid "- Check share permissions (read/write)\\\\\\\\n"
msgstr "- Athugaðu deilingarheimildir (lesa/skrifa)\\\\\\\\n"

msgid "- Ensure NAS is powered on and accessible\\\\\\\\n"
msgstr "- Gakktu úr skugga um að kveikt sé á NAS og aðgengilegt\\\\\\\\n"

msgid "- Enter server IP, share name, username and password\\\\\\\\n"
msgstr "- Sláðu inn IP-tölu netþjóns, deila nafn, notandanafn og lykilorð\\\\\\\\n"

msgid "- Go to Main Menu > Setup > System > Storage Manager\\\\\\\\n"
msgstr "- Farðu í Aðalvalmynd > Uppsetning > Kerfi > Geymslustjóri\\\\\\\\n"

msgid "- HDD backups: Stored in /media/hdd/backup\\\\\\\\n"
msgstr "- HDD öryggisafrit: Geymt í /media/hdd/backup\\\\\\\\n"

msgid "- Keep regular backups of your system\\\\\\\\n"
msgstr "- Haltu reglulega afrit af kerfinu þínu\\\\\\\\n"

msgid "- NET backups: Require mounted CIFS/NFS share with write permissions\\\\\\\\n"
msgstr "- NET öryggisafrit: Krefjast uppsetts CIFS/NFS deilingar með skrifheimildum\\\\\\\\n"

msgid "- Never interrupt backup/restore processes\\\\\\\\n"
msgstr "- Aldrei trufla öryggisafritun/endurheimtunarferli\\\\\\\\n"

msgid "- Restore: Works from HDD, USB, NET or MMC storage\\\\\\\\n"
msgstr "- Endurheimta: Virkar frá HDD, USB, NET eða MMC geymslu\\\\\\\\n"

msgid "- Select 'Network Storage' and add your NAS/SMB share\\\\\\\\n"
msgstr "- Veldu 'Network Storage' og bættu við NAS/SMB deilingunni þinni\\\\\\\\n"

msgid "- Test connection with ping command\\\\\\\\n"
msgstr "- Prófaðu tengingu með ping skipun\\\\\\\\n"

msgid "- USB backups: Require FAT32-formatted drive with 'backupstick' file\\\\\\\\n"
msgstr "- USB afrit: Krefjast FAT32-sniðs drifs með 'backupstick' skrá\\\\\\\\n"

msgid "- Use quality USB drives for recovery sticks\\\\\\\\n"
msgstr "- Notaðu gæða USB-drif fyrir endurheimtarkubba\\\\\\\\n"

msgid "- Verify username/password are correct\\\\\\\\n"
msgstr "- Staðfestu að notendanafn/lykilorð sé rétt\\\\\\\\n"

msgid "- Verify you have enough free storage space\\\\\\\\n"
msgstr "- Staðfestu að þú hafir nóg laust geymslupláss\\\\\\\\n"

msgid "1. Mount your network share first:\\\\\\\\n"
msgstr "1. Settu nethlutinn þinn fyrst:\\\\\\\\n"

msgid "2. Select 'NET Backup' from the device list\\\\\\\\n"
msgstr "2. Veldu 'NET Backup' af tækjalistanum\\\\\\\\n"

msgid "3. Choose your mounted network share\\\\\\\\n"
msgstr "3. Veldu samnýtingu á uppsettu netkerfi\\\\\\\\n"

msgid "A recording is currently running. Please stop the recording before trying to start a flashing."
msgstr "Upptaka er í gangi. Vinsamlegast stöðvuðu upptökuna áður en þú reynir að byrja að blikka."

