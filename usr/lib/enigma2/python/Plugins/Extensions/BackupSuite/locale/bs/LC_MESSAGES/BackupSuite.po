msgid "- Check share permissions (read/write)\n"
msgstr "- Provjerite dozvole za dijeljenje (čitanje/pisanje)\n"

msgid "- Ensure NAS is powered on and accessible\n"
msgstr "- Uvjerite se da je NAS uključen i dostupan\n"

msgid "- Enter server IP, share name, username and password\n"
msgstr "- Unesite IP servera, ime dijeljenja, korisničko ime i lozinku\n"

msgid "- Go to Main Menu > Setup > System > Storage Manager\n"
msgstr "- Idite na Glavni meni > Podešavanje > Sistem > Upravitelj skladišta\n"

msgid "- HDD backups: Stored in /media/hdd/backup\n"
msgstr "- Sigurnosne kopije HDD-a: pohranjene u /media/hdd/backup\n"

msgid "- Keep regular backups of your system\n"
msgstr "- Redovno pravite sigurnosne kopije vašeg sistema\n"

msgid "- NET backups: Require mounted CIFS/NFS share with write permissions\n"
msgstr "- NET sigurnosne kopije: zahtijevaju montirani CIFS/NFS dijeljenje s dozvolama za pisanje\n"

msgid "- Never interrupt backup/restore processes\n"
msgstr "- Nikada nemojte prekidati procese sigurnosnog kopiranja/vraćanja\n"

msgid "- Restore: Works from HDD, USB, NET or MMC storage\n"
msgstr "- Vraćanje: Radi sa HDD, USB, NET ili MMC memorije\n"

msgid "- Select 'Network Storage' and add your NAS/SMB share\n"
msgstr "- Odaberite 'Network Storage' i dodajte svoj NAS/SMB dijeljenje\n"

msgid "- Test connection with ping command\n"
msgstr "- Testirajte vezu sa ping komandom\n"

msgid "- USB backups: Require FAT32-formatted drive with 'backupstick' file\n"
msgstr "- USB sigurnosne kopije: zahtijevaju FAT32 formatiran disk sa 'backupstick' fajlom\n"

msgid "- Use quality USB drives for recovery sticks\n"
msgstr "- Koristite kvalitetne USB diskove za diskove za oporavak\n"

msgid "- Verify username/password are correct\n"
msgstr "- Provjerite jesu li korisničko ime/lozinka ispravni\n"

msgid "- Verify you have enough free storage space\n"
msgstr "- Provjerite imate li dovoljno slobodnog prostora za pohranu\n"

msgid "1. Mount your network share first:\n"
msgstr "1. Prvo montirajte svoj mrežni dio:\n"

msgid "2. Select 'NET Backup' from the device list\n"
msgstr "2. Odaberite 'NET Backup' sa liste uređaja\n"

msgid "3. Choose your mounted network share\n"
msgstr "3. Odaberite svoj instalirani mrežni dio\n"

msgid "A recording is currently running. Please stop the recording before trying to start a flashing."
msgstr "Trenutno je u toku snimanje. Zaustavite snimanje prije nego pokušate započeti treptanje."

