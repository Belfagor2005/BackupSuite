msgid "- Check share permissions (read/write)\\\\\\\\n"
msgstr "- ھەمبەھىرلىنىش ئىجازەتنامىسىنى تەكشۈرۈڭ (ئوقۇش / يېزىش) \\\\\\\\ n"

msgid "- Ensure NAS is powered on and accessible\\\\\\\\n"
msgstr "- NAS نىڭ قوزغىتىلغان ۋە زىيارەت قىلغىلى بولىدىغانلىقىغا كاپالەتلىك قىلىڭ"

msgid "- Enter server IP, share name, username and password\\\\\\\\n"
msgstr "- مۇلازىمېتىر IP نى كىرگۈزۈڭ ، ئورتاق ئىسىم ، ئىشلەتكۈچى ئىسمى ۋە پارول \\\\\\\\ n"

msgid "- Go to Main Menu > Setup > System > Storage Manager\\\\\\\\n"
msgstr "- باش تىزىملىك> تەڭشەش> سىستېما> ساقلاش باشقۇرغۇچى \\\\\\\\ n غا كىرىڭ"

msgid "- HDD backups: Stored in /media/hdd/backup\\\\\\\\n"
msgstr "- HDD زاپاسلاش: / media / hdd / backup \\\\\\\\ n دا ساقلانغان"

msgid "- Keep regular backups of your system\\\\\\\\n"
msgstr "- سىستېمىڭىزنى زاپاسلاڭ"

msgid "- NET backups: Require mounted CIFS/NFS share with write permissions\\\\\\\\n"
msgstr "- NET زاپاسلاش: يېزىش ھوقۇقى بىلەن ئورنىتىلغان CIFS / NFS ھەمبەھىرلەشنى تەلەپ قىلىڭ"

msgid "- Never interrupt backup/restore processes\\\\\\\\n"
msgstr "- زاپاسلاش / ئەسلىگە كەلتۈرۈش جەريانىنى ھەرگىز ئۈزمەڭ \\\\\\\\ n"

msgid "- Restore: Works from HDD, USB, NET or MMC storage\\\\\\\\n"
msgstr "- ئەسلىگە كەلتۈرۈش: HDD ، USB ، NET ياكى MMC ساقلاش \\\\\\\\ n دىن ئىشلەيدۇ"

msgid "- Select 'Network Storage' and add your NAS/SMB share\\\\\\\\n"
msgstr "- «تور ساقلاش» نى تاللاڭ ۋە NAS / SMB ھەمبەھىر \\\\\\\\ n نى قوشۇڭ"

msgid "- Test connection with ping command\\\\\\\\n"
msgstr "- ping بۇيرۇقى بىلەن سىناق ئۇلىنىشى \\\\\\\\ n"

msgid "- USB backups: Require FAT32-formatted drive with 'backupstick' file\\\\\\\\n"
msgstr "- USB زاپاسلاش: «زاپاسلاش» ھۆججىتى بىلەن FAT32 فورماتلانغان قوزغاتقۇچنى تەلەپ قىلىڭ"

msgid "- Use quality USB drives for recovery sticks\\\\\\\\n"
msgstr "- ئەسلىگە كەلتۈرۈش تاياقلىرى ئۈچۈن سۈپەتلىك USB قوزغاتقۇچ ئىشلىتىڭ \\\\\\\\ n"

msgid "- Verify username/password are correct\\\\\\\\n"
msgstr "- ئىشلەتكۈچى ئىسمى / پارولىنىڭ توغرىلىقىنى تەكشۈرۈپ بېقىڭ \\\\\\\\ n"

msgid "- Verify you have enough free storage space\\\\\\\\n"
msgstr "- يېتەرلىك ھەقسىز ساقلاش بوشلۇقىڭىز بارلىقىنى تەكشۈرۈپ بېقىڭ \\\\\\\\ n"

msgid "1. Mount your network share first:\\\\\\\\n"
msgstr "1. ئالدى بىلەن تور ئۈلۈشىڭىزنى ئورنىتىڭ: \\\\\\\\ n"

msgid "2. Select 'NET Backup' from the device list\\\\\\\\n"
msgstr "2. ئۈسكۈنە تىزىملىكىدىن «NET زاپاسلاش» نى تاللاڭ"

msgid "3. Choose your mounted network share\\\\\\\\n"
msgstr "3. ئورناتقان تور ھەمبەھىرىڭىزنى تاللاڭ"

msgid "A recording is currently running. Please stop the recording before trying to start a flashing."
msgstr "ھازىر بىر خاتىرە ئىشلەۋاتىدۇ. چاقماقنى قوزغىتىشتىن بۇرۇن خاتىرىلەشنى توختىتىڭ."

