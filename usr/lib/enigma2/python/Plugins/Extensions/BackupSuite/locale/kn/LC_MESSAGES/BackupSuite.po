msgid "- Check share permissions (read/write)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ಹಂಚಿಕೆ ಅನುಮತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಿ (ಓದಲು/ಬರೆಯಲು)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Ensure NAS is powered on and accessible\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- NAS ಚಾಲಿತವಾಗಿದೆ ಮತ್ತು ಪ್ರವೇಶಿಸಬಹುದಾಗಿದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Enter server IP, share name, username and password\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ಸರ್ವರ್ ಐಪಿ, ಹಂಚಿಕೆ ಹೆಸರು, ಬಳಕೆದಾರಹೆಸರು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ನಮೂದಿಸಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Go to Main Menu > Setup > System > Storage Manager\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ಮುಖ್ಯ ಮೆನು > ಸೆಟಪ್ > ಸಿಸ್ಟಮ್ > ಸ್ಟೋರೇಜ್ ಮ್ಯಾನೇಜರ್\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n ಗೆ ಹೋಗಿ"

msgid "- HDD backups: Stored in /media/hdd/backup\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- HDD ಬ್ಯಾಕಪ್‌ಗಳು: /media/hdd/backup\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n ನಲ್ಲಿ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ"

msgid "- Keep regular backups of your system\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ನಿಮ್ಮ ಸಿಸ್ಟಂನ ನಿಯಮಿತ ಬ್ಯಾಕಪ್‌ಗಳನ್ನು ಇರಿಸಿಕೊಳ್ಳಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- NET backups: Require mounted CIFS/NFS share with write permissions\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- NET ಬ್ಯಾಕಪ್‌ಗಳು: ಬರವಣಿಗೆ ಅನುಮತಿಗಳೊಂದಿಗೆ ಮೌಂಟೆಡ್ CIFS/NFS ಹಂಚಿಕೆ ಅಗತ್ಯವಿದೆ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Never interrupt backup/restore processes\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ಬ್ಯಾಕಪ್/ಮರುಸ್ಥಾಪನೆ ಪ್ರಕ್ರಿಯೆಗಳನ್ನು ಎಂದಿಗೂ ಅಡ್ಡಿಪಡಿಸಬೇಡಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Restore: Works from HDD, USB, NET or MMC storage\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ಮರುಸ್ಥಾಪಿಸಿ: HDD, USB, NET ಅಥವಾ MMC ಸಂಗ್ರಹಣೆಯಿಂದ ಕೆಲಸ ಮಾಡುತ್ತದೆ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Select 'Network Storage' and add your NAS/SMB share\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- 'ನೆಟ್‌ವರ್ಕ್ ಸಂಗ್ರಹಣೆ' ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ NAS/SMB ಹಂಚಿಕೆಯನ್ನು ಸೇರಿಸಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Test connection with ping command\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ಪಿಂಗ್ ಆಜ್ಞೆಯೊಂದಿಗೆ ಸಂಪರ್ಕವನ್ನು ಪರೀಕ್ಷಿಸಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- USB backups: Require FAT32-formatted drive with 'backupstick' file\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- USB ಬ್ಯಾಕಪ್‌ಗಳು: 'ಬ್ಯಾಕ್‌ಅಪ್‌ಸ್ಟಿಕ್' ಫೈಲ್‌ನೊಂದಿಗೆ FAT32-ಫಾರ್ಮ್ಯಾಟ್ ಮಾಡಿದ ಡ್ರೈವ್ ಅಗತ್ಯವಿದೆ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Use quality USB drives for recovery sticks\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ರಿಕವರಿ ಸ್ಟಿಕ್‌ಗಳಿಗಾಗಿ ಗುಣಮಟ್ಟದ USB ಡ್ರೈವ್‌ಗಳನ್ನು ಬಳಸಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Verify username/password are correct\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ಬಳಕೆದಾರಹೆಸರು/ಪಾಸ್‌ವರ್ಡ್ ಸರಿಯಾಗಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "- Verify you have enough free storage space\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "- ನೀವು ಸಾಕಷ್ಟು ಉಚಿತ ಶೇಖರಣಾ ಸ್ಥಳವನ್ನು ಹೊಂದಿರುವಿರಾ ಎಂದು ಪರಿಶೀಲಿಸಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "1. Mount your network share first:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "1. ಮೊದಲು ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಹಂಚಿಕೆಯನ್ನು ಆರೋಹಿಸಿ:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "2. Select 'NET Backup' from the device list\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "2. ಸಾಧನ ಪಟ್ಟಿಯಿಂದ 'NET ಬ್ಯಾಕಪ್' ಆಯ್ಕೆಮಾಡಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "3. Choose your mounted network share\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"
msgstr "3. ನಿಮ್ಮ ಮೌಂಟೆಡ್ ನೆಟ್‌ವರ್ಕ್ ಹಂಚಿಕೆಯನ್ನು ಆರಿಸಿ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "A recording is currently running. Please stop the recording before trying to start a flashing."
msgstr "ರೆಕಾರ್ಡಿಂಗ್ ಪ್ರಸ್ತುತ ಚಾಲನೆಯಲ್ಲಿದೆ. ಮಿನುಗುವಿಕೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲು ಪ್ರಯತ್ನಿಸುವ ಮೊದಲು ದಯವಿಟ್ಟು ರೆಕಾರ್ಡಿಂಗ್ ಅನ್ನು ನಿಲ್ಲಿಸಿ."

